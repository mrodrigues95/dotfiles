{
  "icon_theme": "Colored Zed Icons Theme Dark",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Carbonfox - opaque"
  },
  "project_panel": {
    "entry_spacing": "standard",
    "dock": "left"
  },
  "auto_install_extensions": {
    "html": true,
    "lua": true,
    "oxc": true,
    "nvim-nightfox": true,
    "colored-zed-icons-theme": true
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  }
}
