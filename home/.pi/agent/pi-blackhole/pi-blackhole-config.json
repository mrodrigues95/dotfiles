{
  "compaction": "manual",
  "compactionEngine": "blackhole",
  "compactionSummaryMode": "default",
  "memory": true,
  "sessionFallback": false,

  "observerModel": {
    "provider": "opencode-go",
    "id": "claude-haiku-5-5",
    "thinking": "low"
  },
  "observerFallbackModels": [
    { "provider": "opencode-go", "id": "glm-5.3-flash", "thinking": "low" },
    { "provider": "opencode-go", "id": "mimo-v2.6-flash" }
  ],
  "reflectorModel": {
    "provider": "opencode-go",
    "id": "minimax-m3",
    "thinking": "low"
  },
  "reflectorFallbackModels": [
    { "provider": "opencode-go", "id": "qwen3.8-flash", "thinking": "low" },
    { "provider": "opencode-go", "id": "mimo-v2.6-flash" }
  ],
  "dropperModel": {
    "provider": "opencode-go",
