{
  "compaction": "manual",
  "compactionEngine": "blackhole",
  "compactionSummaryMode": "default",
  "memory": true,
  "sessionFallback": false,

  "model": { "provider": "pi-claude-cli", "id": "claude-sonnet-5-5", "thinking": "low", "cooldownHours": 6 },

  "observerModel": { "provider": "pi-claude-cli", "id": "claude-haiku-5-5", "thinking": "low", "cooldownHours": 6 },
  "observerFallbackModels": [
    { "provider": "pi-claude-cli", "id": "claude-sonnet-5", "thinking": "low", "cooldownHours": 6 }
  ],
  "reflectorModel": { "provider": "pi-claude-cli", "id": "claude-sonnet-5", "thinking": "low", "cooldownHours": 6 },
  "reflectorFallbackModels": [
    { "provider": "pi-claude-cli", "id": "claude-sonnet-5-5", "thinking": "low", "cooldownHours": 6 },
    { "provider": "pi-claude-cli", "id": "claude-haiku-5-5", "thinking": "low", "cooldownHours": 6 }
  ],
  "dropperModel": { "provider": "pi-claude-cli", "id": "claude-haiku-5-5", "thinking": "off", "cooldownHours": 6 },
  "dropperFallbackModels": [
    { "provider": "pi-claude-cli", "id": "claude-sonnet-5", "thinking": "off", "cooldownHours": 6 }
  ],

  "observeAfterTokens": 15000,
  "reflectAfterTokens": 25000,
  "observationsPoolMaxTokens": 20000,
  "observationsPoolTargetTokens": 10000,
  "reflectionsPoolMaxTokens": 8000,
  "fullFoldAlways": true,
  "reflectorInputMaxTokens": 80000,
  "dropperInputMaxTokens": 80000,
  "dropperPressureThreshold": 0.7,
  "dropperPoolFullnessThreshold": 0.1,
  "observerChunkMaxTokens": 40000,
  "observerPreambleMaxTokens": 0,
  "agentMaxTurns": 16,

  "skipForProviders": [],
  "tailBehavior": "minimal",
  "midRunCompaction": "off",
  "compactAfterPreset": "default",

  "retainedToolOutputMaxTokens": 20000,
  "recallResponseMaxChars": 48000,
  "showPreCompactionMessage": true,

  "statusBar": true,
  "showWorkerNotifications": true,
  "debug": false,
  "debugLog": false
}
